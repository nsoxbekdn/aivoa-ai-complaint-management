# Copy to backend/.env and fill in. Never commit the real .env.

# --- database ---------------------------------------------------------------
# PostgreSQL is the implementation target for this assignment and matches
# docker-compose.yml. Start it with:  docker compose up -d db
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa
#
# Lightweight fallback for a machine without Docker/PostgreSQL (also what the
# test suite uses). Same models, same migration, no other change required:
#   DATABASE_URL=sqlite:///./aivoa.db

# --- LLM ---------------------------------------------------------------------
# Groq API key — https://console.groq.com/keys . Backend only, never exposed to the browser.
GROQ_API_KEY=

# Swap models without touching code. The original assessment named gemma2-9b-it;
# Groq retired that model, so these are currently supported Groq production models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Wording of the intake assistant's replies only — never a decision, never a stored value.
# Deliberately the small model: it keeps GROQ_MODEL's token budget for the work that matters.
GROQ_REPLY_MODEL=openai/gpt-oss-20b

# gpt-oss is a reasoning model and bills its chain of thought against the completion
# budget; "low" keeps enough of that budget for the answer itself. Groq accepts only
# low | medium | high. Leave this EMPTY if you switch GROQ_MODEL to a model without a
# reasoning mode (llama-3.3-70b-versatile, for example) — it would reject the parameter.
GROQ_REASONING_EFFORT=low

# --- API ---------------------------------------------------------------------
# Comma-separated list is supported.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_SIZE_MB=5
MAX_INPUT_CHARS=40000
MAX_EXTRACTION_RETRIES=1
